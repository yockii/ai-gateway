# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=llm_gateway
DB_PASSWORD=llm_gateway
DB_NAME=llm_gateway
DB_SSLMODE=disable

# Bifrost 配置
BIFROST_CONFIG_PATH=./config/bifrost.json

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=json

# 成本优化配置
DEFAULT_PROFIT_MARGIN=0.1
MIN_PROFIT_MARGIN=0.05

# 性能配置
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT=30

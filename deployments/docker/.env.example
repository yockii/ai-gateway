# AI Gateway Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_gateway
DB_USER=postgres
DB_PASSWORD=postgres

# PostgreSQL exposed port (for local development)
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Redis exposed port (for local development)
REDIS_PORT=6379

# ============================================
# Docker Configuration
# ============================================
DOCKER_REGISTRY=ai-gateway
IMAGE_TAG=latest

# For production with registry:
# DOCKER_REGISTRY=your-registry.com/ai-gateway
# IMAGE_TAG=v1.0.0

# ============================================
# Logging Configuration
# ============================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# Options: text, json
LOG_FORMAT=text

# ============================================
# Security Configuration
# ============================================
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API Keys (comma-separated for development)
# API_KEYS=key1,key2,key3

# ============================================
# Monitoring Configuration
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# Pricing Configuration
# ============================================
DEFAULT_PROFIT_MARGIN=0.1
MIN_PROFIT_MARGIN=0.05

# ============================================
# SSL/TLS Configuration (for nginx)
# ============================================
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem

# Let's Encrypt email (for certbot)
# LETS_ENCRYPT_EMAIL=admin@example.com
# DOMAIN=api.example.com

# ============================================
# Blue-Green Deployment
# ============================================
# Current deployment color (blue or green)
DEPLOYMENT_COLOR=blue

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/backups

# ============================================
# Alert Configuration
# ============================================
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=noreply@example.com
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=

# Slack alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
